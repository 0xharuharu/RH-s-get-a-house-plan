# 複製此檔案為 secrets.toml 並填入你的值（本機開發用）
# Streamlit Cloud 部署時在網站介面直接貼入下方內容即可。
#
# 取得方式：
#   github_token → GitHub 設定 → Developer settings → Personal access tokens
#                  권限選擇 "gist"（只需 gist 一個 scope）
#   gist_id      → 建立私人 Gist 後，網址最後一段即為 ID
#                  例：https://gist.github.com/yourname/abc123def456  → abc123def456

github_token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
gist_id      = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
